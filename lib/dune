(rule
 (targets docs_data.ml)
 (deps
  ../tools/gen_docs/gen_docs.exe
  ../docs/guides/debug.md
  ../docs/guides/effect.md
  ../docs/guides/ox.md)
 (action
  (with-stdout-to
   docs_data.ml
   (run
    %{dep:../tools/gen_docs/gen_docs.exe}
    debug:../docs/guides/debug.md
    effect:../docs/guides/effect.md
    ox:../docs/guides/ox.md))))

(rule
 (targets version.ml)
 (action
  (with-stdout-to
   %{targets}
   (echo "let value = \"%{version:inn}\""))))

(library
 (name inn)
 (public_name inn)
 (libraries ox ox_http ox_sql eio eio.unix yojson unix))
