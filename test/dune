(test
 (name test_inn)
 (package inn)
 (deps ../README.md ../docs/guides/eta.md eta_guide_snippet.ml)
 (libraries inn alcotest eta eta_http eta_sql eio_main unix)
 ; The suite starts many short-lived Eio runtimes. Each io_uring ring locks
 ; memory against a per-user cap that this sandbox sets to 8 MiB, so under
 ; contention with other processes Eio_main.run fails with
 ; "io_uring_queue_init: ENOMEM" and hides real failures. The posix backend
 ; is the same Eio API without io_uring, so the tests stay deterministic.
 (action
  (setenv
   EIO_BACKEND
   posix
   (run %{test}))))

(test
 (name test_mcp)
 (package inn)
 (libraries inn alcotest yojson))

; The Eta guide's exporter snippet, compiled against the real Eta API. The
; Alcotest suite checks that docs/guides/eta.md carries exactly this source, so
; the guide cannot drift from an API it does not compile against. Enable
; the compiled example, and the check that runs it against a real isolated Inn,
; with INN_ETA_GUIDE_SNIPPET=1.

(executable
 (name eta_guide_snippet)
 (enabled_if
  (= %{env:INN_ETA_GUIDE_SNIPPET=0} 1))
 (flags
  (:standard -w -32))
 (libraries eta eta_observability eta_otel eta_http eio_main))

(rule
 (alias runtest)
 (enabled_if
  (= %{env:INN_ETA_GUIDE_SNIPPET=0} 1))
 (action
  (run ./eta_guide_snippet.exe)))

(cram
 (deps
  ../bin/main.exe
  ../scripts/install-inn-service.sh
  ../README.md
  ../docs/guides/effect.md
  check_mcp.py
  check_cli.py
  check_trace_cli.py
  check_service.py
  check_hints.py
  check_install.py
  check_effect_guide.py))

; The compiled example, pointed at a real Inn on a free port and a temporary
; state directory, must leave the counter and the histogram in GET /metrics.

(rule
 (alias runtest)
 (enabled_if
  (= %{env:INN_ETA_GUIDE_SNIPPET=0} 1))
 (deps ../bin/main.exe eta_guide_snippet.exe check_eta_guide.py)
 (action
  (run python3 check_eta_guide.py ../bin/main.exe eta_guide_snippet.exe)))
